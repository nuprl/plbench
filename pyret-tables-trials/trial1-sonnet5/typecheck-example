#!/usr/bin/env bash
# Type-check a single Pyret program with the (modified) TypeScript compiler.
#
# Usage: typecheck-example FILE.arr
#
# Exits 0 if FILE.arr has no type error, non-zero (with the type error
# printed to stdout/stderr) otherwise. This drives the ts-compiler's
# `-type-check` compilation phase directly -- the same type checking used to
# validate the programs under /app/typed-examples/.

set -u

# Resolve the pyret-lang checkout regardless of where this script is invoked
# from: default to the well-known container layout, but allow overriding via
# PYRET_LANG_DIR for other setups.
PYRET_LANG_DIR="${PYRET_LANG_DIR:-/app/pyret-lang}"
LANG_DIR="$PYRET_LANG_DIR/lang"

if [ "$#" -ne 1 ]; then
  echo "usage: $(basename "$0") FILE.arr" >&2
  exit 2
fi

FILE="$1"
if [ ! -f "$FILE" ]; then
  echo "typecheck-example: no such file: $FILE" >&2
  exit 2
fi
# The compiler resolves relative paths against its own cwd; make FILE absolute
# so this script can be invoked from anywhere.
case "$FILE" in
  /*) ;;
  *) FILE="$(pwd)/$FILE" ;;
esac

PYRET_JS="$LANG_DIR/build/ts-compiler/pyret.js"
if [ ! -f "$PYRET_JS" ]; then
  echo "typecheck-example: $PYRET_JS not found -- run 'make ts-compiler' in $LANG_DIR first" >&2
  exit 2
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# Run from $LANG_DIR so the compiler's own node_modules (e.g. `resolve`)
# resolve correctly; --compiled-dir is a fresh scratch dir per invocation so
# repeated runs on the same filename don't share (possibly stale) caches.
(
  cd "$LANG_DIR" || exit 2
  node --max-old-space-size=8192 "$PYRET_JS" \
    -type-check \
    --builtin-js-dir src/js/trove/ \
    --builtin-arr-dir src/arr/trove/ \
    --require-config src/scripts/standalone-configA.json \
    --compiled-dir "$WORK/compiled/" \
    --build-runnable "$FILE" \
    --outfile "$WORK/out.jarr" \
    -no-display-progress
)
exit $?
