+
+async function typeCheckSource(source) {
+  const tmpFile = path.join(os.tmpdir(), 'ts-unit-tablecheck-' + process.pid + '-' + Math.random().toString(36).slice(2) + '.arr');
+  fs.writeFileSync(tmpFile, source);
+  try {
+    const options = {
+      ...CS.makeDefaultCompileOptions(PYRET_LANG),
+      typeCheck: true,
+      checks: 'none',
+      compileModule: false,
+      displayProgress: false,
+    };
+    const result = await CLI.compile(tmpFile, options);
+    const errors = [];
+    for (const loadable of result.loadables) {
+      if (CS.isErr(loadable.resultPrinter)) { errors.push(...loadable.resultPrinter.problems); }
+    }
+    return errors;
+  } finally {
+    fs.unlinkSync(tmpFile);
+  }
+}
+
+async function testAsync(name, fn) {
+  try {
+    await fn();
+    passed++;
+    console.log('ok   ' + name);
+  } catch (e) {
+    failed++;
+    console.log('FAIL ' + name + ': ' + e.message);
+    if (process.env.VERBOSE) console.log(e.stack);
+  }
+}
+
+function assertNoErrors(errors, msg) {
+  assert.strictEqual(errors.length, 0, (msg || 'expected no errors') + ': ' + errors.map((e) => e.$name).join(', '));
+}
+function assertHasError(errors, name, msg) {
+  assert.ok(errors.some((e) => e.$name === name),
+    (msg || `expected an error of kind ${name}`) + '; got: ' + errors.map((e) => e.$name).join(', '));
+}
+
+async function runTableCheckTests() {
+  await testAsync('table-check: Table<{...}> literal with matching schema is accepted', async () => {
+    const errs = await typeCheckSource(`
+      t :: Table<{name :: String, age :: Number}> =
+        table: name, age
+          row: "Alicia", 30
+        end
+    `);
+    assertNoErrors(errs);
+  });
+
+  await testAsync('table-check: select on a known-missing column is rejected', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = select nickname from t end
+    `);
+    assertHasError(errs, 'table-type-column-not-found');
+  });
+
+  await testAsync('table-check: select on an existing column is accepted', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = select name from t end
+    `);
+    assertNoErrors(errs);
+  });
+
+  await testAsync('table-check: extract on a known-missing column is rejected', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = extract nickname from t end
+    `);
+    assertHasError(errs, 'table-type-column-not-found');
+  });
+
+  await testAsync('table-check: order-by the same column twice is rejected', async () => {
+    const errs = await typeCheckSource(`
+      t = table: a, b row: 1, 2 end
+      s = order t: a ascending, a descending end
+    `);
+    assertHasError(errs, 'table-type-duplicate-sort-column');
+  });
+
+  await testAsync('table-check: .drop on a missing column is rejected', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = t.drop("nickname")
+    `);
+    assertHasError(errs, 'table-type-column-not-found');
+  });
+
+  await testAsync('table-check: .build-column re-adding an existing column is rejected', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = t.build-column("name", lam(r): "x" end)
+    `);
+    assertHasError(errs, 'table-type-duplicate-column');
+  });
+
+  await testAsync('table-check: .build-column with a fresh column name is accepted', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = t.build-column("greeting", lam(r): "hi" end)
+    `);
+    assertNoErrors(errs);
+  });
+
+  await testAsync('table-check: .rename-column onto an already-existing name is rejected', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      s = t.rename-column("name", "age")
+    `);
+    assertHasError(errs, 'table-type-duplicate-column');
+  });
+
+  await testAsync('table-check: .stack requires the same column-name set', async () => {
+    const errs = await typeCheckSource(`
+      t1 = table: a, b row: 1, 2 end
+      t2 = table: a, c row: 1, 2 end
+      s = t1.stack(t2)
+    `);
+    assertHasError(errs, 'table-type-schema-mismatch');
+  });
+
+  await testAsync('table-check: function width-subtyping accepts a table with extra columns', async () => {
+    const errs = await typeCheckSource(`
+      fun f(t :: Table<{age :: Number}>) -> Number: t.length() end
+      people :: Table<{name :: String, age :: Number}> =
+        table: name, age row: "Alicia", 30 end
+      n = f(people)
+    `);
+    assertNoErrors(errs);
+  });
+
+  await testAsync('table-check: function width-subtyping rejects a table missing a required column', async () => {
+    const errs = await typeCheckSource(`
+      fun f(t :: Table<{age :: Number}>) -> Number: t.length() end
+      people :: Table<{name :: String}> =
+        table: name row: "Alicia" end
+      n = f(people)
+    `);
+    assertHasError(errs, 'table-type-column-not-found');
+  });
+
+  await testAsync('table-check: a Row bracket access on a known column is accepted', async () => {
+    const errs = await typeCheckSource(`
+      t = table: name, age row: "Alicia", 30 end
+      f = lam(r :: Row<{name :: String}>): r["name"] == "Alicia" end
+    `);
+    assertNoErrors(errs);
+  });
+
+  await testAsync('table-check: a Row bracket access on an unknown column is rejected', async () => {
+    const errs = await typeCheckSource(`
+      f = lam(r :: Row<{name :: String}>): r["nickname"] end
+    `);
+    assertHasError(errs, 'table-type-column-not-found');
+  });
+
+  await testAsync('table-check: a program with no table-type annotations is unaffected (fully backward compatible)', async () => {
+    const errs = await typeCheckSource(`
+      t :: Table = table: name, age row: "Alicia", 30 end
+      s = t.drop("anything-at-all")
+    `);
+    assertNoErrors(errs);
+  });
+}
+
+runTableCheckTests().then(() => {
+  console.log('');
+  console.log(`unit tests: ${passed} passed, ${failed} failed`);
+  process.exit(failed === 0 ? 0 : 1);
+}).catch((e) => {
+  console.error('table-check unit tests crashed:', e.stack);
+  process.exit(1);
+});
